<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n" />
    <property name="LOG_DIR" value="${LOG_DIR:-/tmp/ecommerce-logs}" />

    <!-- Console Appender: Primary for Containerized Cloud Environments (Render, Docker, K8s) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Daily Rolling File Appender: Writes safely to writable directory (/tmp/ecommerce-logs or custom LOG_DIR) -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/application-%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Application Loggers -->
    <logger name="com.example.ecommerce" level="${LOG_LEVEL:-INFO}" />
    <logger name="com.zaxxer.hikari" level="INFO" />
    <logger name="org.apache.catalina" level="WARN" />
    <logger name="org.springframework.web" level="INFO" />

    <!-- Root Logger: Direct all output to CONSOLE for zero-friction cloud deployments -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>

</configuration>
