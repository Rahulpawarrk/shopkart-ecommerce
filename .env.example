# ==============================================================================
# ShopKart E-Commerce Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your .env file to Git!
# ==============================================================================

# ── Application Ports ────────────────────────────────────────────────────────
APP_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
JENKINS_PORT=8085

# ── PostgreSQL Database Configuration ───────────────────────────────────────
POSTGRES_DB=ecommerce_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password_here
DB_DRIVER=org.postgresql.Driver
# Optional override for full JDBC URL (defaults to container postgres):
# DB_URL=jdbc:postgresql://postgres:5432/ecommerce_db

# ── Redis Cache & Session Store ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Payment Gateway (Razorpay) ──────────────────────────────────────────────
# Test or Live API keys from: https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# ── SMS Gateway (Fast2SMS) ──────────────────────────────────────────────────
# Leave empty for SMS Simulation mode (logs OTPs to console)
FAST2SMS_API_KEY=

# ── Logistics & Carrier Webhooks ────────────────────────────────────────────
LOGISTICS_WEBHOOK_SECRET=your_webhook_secret_here
